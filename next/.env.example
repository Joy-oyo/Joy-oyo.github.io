# Environment variables for Joy Chen Portfolio
# Copy this to .env.local and fill in real values.

# Gmail app password required for contact-form email verification.
# Generate one at https://myaccount.google.com/apppasswords
EMAIL_USER=your-gmail@gmail.com
EMAIL_PASS=your-gmail-app-password

# Origin of the ASR Transcriber demo, which is a separate repo and a separate
# Vercel project stitched in at /asrtranscriber as a Next.js multi-zone.
# Without this the rewrite in next.config.mjs is skipped entirely and
# /asrtranscriber 404s — which also makes the demo card on /demos a dead link.
#
# Production: the demo's own deployment origin, https only.
#   ASR_DEMO_ORIGIN=https://asr-transcriber.vercel.app
# Local: run `npm run dev` in the asr-transcriber repo (it serves port 3000
# under its own basePath) and point at the loopback address.
ASR_DEMO_ORIGIN=http://localhost:3000
